# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Postgres). For local dev, run `docker compose up -d` in this
# folder (starts Postgres via docker-compose.yml) and use the URL below.
# In production (e.g. Render) this is provided automatically by the
# managed Postgres instance defined in render.yaml.
DATABASE_URL="postgresql://cassa:cassa@localhost:5432/cassa_parrocchiale"

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Email (SMTP). If left empty, emails are logged to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cassa Parrocchiale <no-reply@cassaparrocchiale.local>"

# Default parish created on first seed
DEFAULT_PARISH_NAME="Parrocchia Santa Maria"
DEFAULT_ADMIN_EMAIL=admin@parrocchia.local
DEFAULT_ADMIN_PASSWORD=Admin123!
