# StreamPulse AI - Celery worker / beat (FFmpeg, faster-whisper). GPU used when the NVIDIA runtime is available.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend:/app STORAGE_ROOT=/data/storage HF_HOME=/data/models
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core fonts-liberation \
      fontconfig curl && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 1000 streampulse
WORKDIR /app
COPY requirements.txt requirements-ai.txt ./
RUN pip install -r requirements.txt -r requirements-ai.txt
# Optional CUDA runtime libraries for faster-whisper on NVIDIA GPUs (build with --build-arg INSTALL_CUDA=1)
ARG INSTALL_CUDA=0
RUN if [ "$INSTALL_CUDA" = "1" ]; then pip install "nvidia-cublas-cu12" "nvidia-cudnn-cu12==9.*"; fi
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib
COPY backend/ backend/
COPY processing/ processing/
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && mkdir -p /data/storage /data/models && chown -R streampulse /data
USER streampulse
WORKDIR /app/backend
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["worker"]
